rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // workouts/{workoutId} is a top-level collection; ownership is stored in
    // the `userId` field (see WorkoutRepositoryImpl). A signed-in user can only
    // read and write workouts whose userId is their own uid. List queries pass
    // because the app always filters with where('userId', isEqualTo: uid).
    match /workouts/{workoutId} {
      allow read, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // The owner cannot hand a workout over to another user.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Everything else is denied by default.
  }
}
